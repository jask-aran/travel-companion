{
  "name": "travel-companion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @travel-companion/web dev",
    "build": "pnpm --filter @travel-companion/web build",
    "preview": "pnpm --filter @travel-companion/web preview",
    "trip:init": "tsx scripts/init-trip.ts",
    "trip:keys": "tsx scripts/keys.ts",
    "trip:pull": "tsx scripts/refresh-trip.ts",
    "trip:rebuild": "tsx scripts/refresh-trip.ts --source saved",
    "typecheck": "tsc --noEmit && pnpm --filter @travel-companion/web typecheck",
    "test": "vitest run",
    "ship": "tsx scripts/ship.ts",
    "ship:dry": "tsx scripts/ship.ts --dry-run",
    "ship:check": "tsx scripts/ship.ts --check",
    "mcp": "tsx scripts/mcp-local.ts"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "11.2.0",
    "valibot": "^1.4.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.151.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
